# Chave da API do OpenRouter
# Acesse https://openrouter.ai/keys para gerar a sua.
OPENROUTER_API_KEY="sk-or-v1-..."
# Escolha o modelo que deseja do catálogo deles (ex: openai/gpt-4o, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL="openai/gpt-4o"

# Configurações do Banco de Dados (PostgreSQL via Docker)
# Repasse estes exatos valores pro seu .env para conectar ao banco que o docker-compose criou
POSTGRES_HOST="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="[PASSWORD]"
POSTGRES_DB="uiengine"
